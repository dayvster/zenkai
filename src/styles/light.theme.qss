QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
}

#searchbarInput {
    background-color: #e6e9ef;
    color: #4c4f69;
    border-color: #ccd0da;
    selection-background-color: #acb0be;
    selection-color: #4c4f69;
}

#searchbarInput:focus {
    border-color: #7287fd;
}

#searchbarInput::placeholder {
    color: #9ca0b0;
}

#appList QScrollBar:vertical {
    background-color: #eff1f5;
}

#appList QScrollBar::handle:vertical {
    background-color: #ccd0da;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #acb0be;
}

#bottomBar QToolButton:hover {
    background-color: #e6e9ef;
}

#appList::item:selected {
    background: #ccd0da;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #eff1f5);
}

#bottomBar {
    background: #eff1f5;
    border-top: 1px solid #ccd0da;
}

#bottomBar QLabel {
    color: #9ca0b0;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #4c4f69;
}

#actionButton:hover {
    background: #e6e9ef;
    border: 1px solid #ccd0da;
}

#actionShortcut {
    color: #9ca0b0;
    background: transparent;
}

#actionName {
    color: #4c4f69;
    background: transparent;
}
