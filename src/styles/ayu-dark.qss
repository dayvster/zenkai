QWidget {
    background-color: #0d1017;
    color: #bfc7d5;
}

#searchbarInput {
    background-color: #131721;
    color: #bfc7d5;
    border-color: #1f2430;
    selection-background-color: #e6b450;
    selection-color: #0d1017;
}

#searchbarInput:focus {
    border-color: #f29718;
}

#searchbarInput::placeholder {
    color: #565f73;
}

#appList {
    background: #0d1017;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #bfc7d5;
}

#appList::item:selected {
    background: #f29718;
    color: #0d1017;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #1f2430;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #95e6cb;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #0d1017;
    border-top: 1px solid #1f2430;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #bfc7d5;
}

#bottomBar QToolButton:hover {
    background-color: #131721;
    border: 1px solid #f29718;
}

#bottomBar QLabel {
    color: #565f73;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #bfc7d5;
    border-radius: 4px;
}

#actionButton:hover {
    background: #131721;
    border: 1px solid #f29718;
}

#actionShortcut {
    color: #565f73;
    background: transparent;
}

#actionName {
    color: #bfc7d5;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #0d1017);
}
