QWidget {
    background-color: #002b36;
    color: #93a1a1;
}

#searchbarInput {
    background-color: #073642;
    color: #93a1a1;
    border-color: #586e75;
    selection-background-color: #268bd2;
    selection-color: #002b36;
}

#searchbarInput:focus {
    border-color: #2aa198;
}

#searchbarInput::placeholder {
    color: #657b83;
}

#appList {
    background: #002b36;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #93a1a1;
}

#appList::item:selected {
    background: #268bd2;
    color: #002b36;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #586e75;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #d33682;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #002b36;
    border-top: 1px solid #586e75;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #93a1a1;
}

#bottomBar QToolButton:hover {
    background-color: #073642;
    border: 1px solid #b58900;
}

#bottomBar QLabel {
    color: #657b83;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #93a1a1;
    border-radius: 4px;
}

#actionButton:hover {
    background: #073642;
    border: 1px solid #2aa198;
}

#actionShortcut {
    color: #657b83;
    background: transparent;
}

#actionName {
    color: #93a1a1;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #002b36);
}
