QWidget {
    background-color: #0a0e1a;
    color: #e0e0f5;
}

#searchbarInput {
    background-color: #141a33;
    color: #e0e0f5;
    border-color: #1e2d5a;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
}

#searchbarInput:focus {
    border-color: #ffc107;
}

#searchbarInput::placeholder {
    color: #6b7db3;
}

#appList {
    background: #0a0e1a;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #e0e0f5;
}

#appList::item:selected {
    background: #1e3a8a;
    color: #ffffff;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #1e2d5a;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #ffc107;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #0a0e1a;
    border-top: 1px solid #1e2d5a;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #e0e0f5;
}

#bottomBar QToolButton:hover {
    background-color: #141a33;
    border: 1px solid #ffc107;
}

#bottomBar QLabel {
    color: #6b7db3;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #e0e0f5;
    border-radius: 4px;
}

#actionButton:hover {
    background: #141a33;
    border: 1px solid #ffc107;
}

#actionShortcut {
    color: #6b7db3;
    background: transparent;
}

#actionName {
    color: #e0e0f5;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #0a0e1a);
}
