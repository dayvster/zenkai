/*
 * Ember: a warm dark theme built around an amber accent.
 *
 * Colors from the Ember color scheme by Michal Wilk (MIT License, Copyright (c) 2025
 * Michal Wilk), https://github.com/MichalWilk/ember-color-scheme. The window, search bar
 * and app list share the base background, so they read as one surface split by the search
 * bar's border; the other colors keep the roles the scheme gives them:
 *   bg_hard #1a1918  base background      bg_statusline #141312  bottom bar
 *   bg1     #2e2c2a  hover surfaces       bg_selected   #362510  selection
 *   bg2     #3e3c3a  borders              orange        #fe8019  primary accent
 *   fg      #e8e4dd  primary text         fg_dim        #9a9491  muted text
 *   fg_bright #ffffff  emphasized text
 */

QWidget {
    background-color: #1a1918;
    color: #e8e4dd;
}

#searchbarInput {
    background-color: #1a1918;
    color: #e8e4dd;
    border-color: #3e3c3a;
    selection-background-color: #fe8019;
    selection-color: #1a1918;
}

#searchbarInput:focus {
    border-color: #fe8019;
}

#searchbarInput::placeholder {
    color: #9a9491;
}

#appList {
    background: #1a1918;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #e8e4dd;
}

#appList::item:selected {
    background: #362510;
    color: #fe8019;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #3e3c3a;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #fe8019;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #141312;
    border-top: 1px solid #3e3c3a;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #e8e4dd;
}

#bottomBar QToolButton:hover {
    background-color: #2e2c2a;
    border: 1px solid #fe8019;
}

#bottomBar QLabel {
    color: #9a9491;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #e8e4dd;
    border-radius: 4px;
}

#actionButton:hover {
    background: #2e2c2a;
    border: 1px solid #fe8019;
}

#actionShortcut {
    color: #9a9491;
    background: transparent;
}

#actionName {
    color: #e8e4dd;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #1a1918);
}

#actionPanel {
    background-color: #1a1918;
    color: #e8e4dd;
    border-color: #3e3c3a;
}

#actionMenuSearch {
    background-color: #1a1918;
    color: #e8e4dd;
    border-color: #3e3c3a;
    selection-background-color: #fe8019;
    selection-color: #1a1918;
}

#actionMenuSearch:focus {
    border-color: #fe8019;
}

#actionMenuSearch::placeholder {
    color: #9a9491;
}

#actionMenuTitle {
    color: #ffffff;
}

#actionMenuContext,
#actionMenuHint,
#actionMenuEmpty {
    color: #9a9491;
}

#actionList::item:selected {
    background-color: #362510;
    color: #fe8019;
}
