QWidget {
    background-color: #282a36;
    color: #f8f8f2;
}

#searchbarInput {
    background-color: #44475a;
    color: #f8f8f2;
    border-color: #44475a;
    selection-background-color: #ff79c6;
    selection-color: #282a36;
}

#searchbarInput:focus {
    border-color: #bd93f9;
}

#searchbarInput::placeholder {
    color: #6272a4;
}

#appList {
}

#appList::item {
}

#appList::item:hover {
}

#appList::item:current,
#appList::item:selected {
}

#appList QScrollBar:vertical {
    background-color: transparent;
}

#appList QScrollBar::handle:vertical {
    background-color: #44475a;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #ff79c6;
}

#bottomBar QToolButton {
}

#bottomBar QToolButton:hover {
    background-color: #44475a;
}

#bottomBar QLabel {
    color: #6272a4;
}
