QWidget {
    font-family: "Fira Sans", "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

#searchbarInput {
    border: none;
    border-bottom: 1px solid palette(mid);
    border-radius: 0;
    padding: 18px 20px;
    font-size: 18px;
}

#appList {
    border: none;
    padding: 8px 0;
    outline: none;
}

#appList::item {
    padding: 8px 12px;
    margin: 2px 8px;
    border-radius: 6px;
}

#appList QScrollBar:vertical {
    background: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    border-radius: 3px;
    min-height: 24px;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: transparent;
}

#actionItem {
    background: transparent;
}

#actionShortcut {
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 11px;
}

#actionList::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

#actionMenuTitle {
    background: transparent;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 12px 2px;
}

#actionMenuContext {
    background: transparent;
    color: palette(placeholder-text);
    font-size: 12px;
    padding: 0 12px 12px;
}

#actionMenuSearch {
    background: transparent;
    border: 1px solid palette(mid);
    border-radius: 8px;
    margin: 0 4px 8px;
    padding: 10px 12px;
    font-size: 13px;
    selection-background-color: palette(highlight);
}

#actionMenuSearch:focus {
    border-color: palette(highlight);
}

#actionMenuHint {
    background: transparent;
    color: palette(placeholder-text);
    font-size: 11px;
    padding: 12px 12px 6px;
}

#actionMenuEmpty {
    background: transparent;
    color: palette(placeholder-text);
    padding: 22px 12px;
}
QWidget#actionPanel {
    padding: 0;
    border: none;
    border-left: 1px solid palette(mid);
    border-radius: 0;
}
#actionList {
    background: transparent;
    border: none;
    padding: 0;
    outline: none;
    font-size: 12px;
}
#actionList::item {
    padding: 6px;
    margin: 1px 0;
    border-radius: 6px;
}
#actionList QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 0;
}
#actionList QScrollBar::handle:vertical {
    background: palette(mid);
    min-height: 24px;
    border-radius: 4px;
}
#actionList QScrollBar::add-line:vertical, #actionList QScrollBar::sub-line:vertical {
    height: 0;
}
QWidget#filePreview {
    border-left: 1px solid palette(mid);
}
QWidget#filePreview QPlainTextEdit {
    border: none;
    background: transparent;
    color: palette(text);
    font-family: monospace;
    font-size: 12px;
}

#actionMenuSearch::placeholder { color: palette(placeholder-text); }
