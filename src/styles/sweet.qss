QWidget {
    background-color: #1a1a2e;
    color: #ffffff;
}

#searchbarInput {
    background-color: #16213e;
    color: #ffffff;
    border-color: #b388ff;
    selection-background-color: #ff80ab;
    selection-color: #ffffff;
}

#searchbarInput:focus {
    border-color: #ff80ab;
}

#searchbarInput::placeholder {
    color: #7c7caa;
}

#appList {
    background: #1a1a2e;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #ffffff;
}

#appList::item:selected {
    background: #b388ff;
    color: #ffffff;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #2a2a4e;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #ff80ab;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #1a1a2e;
    border-top: 1px solid #2a2a4e;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #ffffff;
}

#bottomBar QToolButton:hover {
    background-color: #16213e;
    border: 1px solid #ff80ab;
}

#bottomBar QLabel {
    color: #7c7caa;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #ffffff;
    border-radius: 4px;
}

#actionButton:hover {
    background: #16213e;
    border: 1px solid #ff80ab;
}

#actionShortcut {
    color: #7c7caa;
    background: transparent;
}

#actionName {
    color: #ffffff;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #1a1a2e);
}
