QWidget {
    background-color: #1e1e1e;
    color: #e5e5e5;
}

#searchbarInput {
    background-color: #333333;
    color: #e5e5e5;
    border-color: #3d3d3d;
    selection-background-color: #3584e4;
    selection-color: #ffffff;
}

#searchbarInput:focus {
    border-color: #3584e4;
}

#searchbarInput::placeholder {
    color: #767676;
}

#appList {
    background: #1e1e1e;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #e5e5e5;
}

#appList::item:selected {
    background: #3584e4;
    color: #ffffff;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #3d3d3d;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #3584e4;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #1e1e1e;
    border-top: 1px solid #3d3d3d;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #e5e5e5;
}

#bottomBar QToolButton:hover {
    background-color: #333333;
    border: 1px solid #3584e4;
}

#bottomBar QLabel {
    color: #767676;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #e5e5e5;
    border-radius: 4px;
}

#actionButton:hover {
    background: #333333;
    border: 1px solid #3584e4;
}

#actionShortcut {
    color: #767676;
    background: transparent;
}

#actionName {
    color: #e5e5e5;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #1e1e1e);
}
