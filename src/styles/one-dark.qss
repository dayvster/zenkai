QWidget {
    background-color: #282c34;
    color: #abb2bf;
}

#searchbarInput {
    background-color: #2c313a;
    color: #abb2bf;
    border-color: #3e4452;
    selection-background-color: #61afef;
    selection-color: #282c34;
}

#searchbarInput:focus {
    border-color: #56b6c2;
}

#searchbarInput::placeholder {
    color: #5c6370;
}

#appList {
    background: #282c34;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #abb2bf;
}

#appList::item:selected {
    background: #61afef;
    color: #282c34;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #3e4452;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #c678dd;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #282c34;
    border-top: 1px solid #3e4452;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #abb2bf;
}

#bottomBar QToolButton:hover {
    background-color: #2c313a;
    border: 1px solid #e5c07b;
}

#bottomBar QLabel {
    color: #5c6370;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #abb2bf;
    border-radius: 4px;
}

#actionButton:hover {
    background: #2c313a;
    border: 1px solid #61afef;
}

#actionShortcut {
    color: #5c6370;
    background: transparent;
}

#actionName {
    color: #abb2bf;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #282c34);
}
