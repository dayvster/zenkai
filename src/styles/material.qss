QWidget {
    background-color: #121212;
    color: #e0e0e0;
}

#searchbarInput {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border-color: #2c2c2c;
    selection-background-color: #d0bcff;
    selection-color: #000000;
}

#searchbarInput:focus {
    border-color: #d0bcff;
}

#searchbarInput::placeholder {
    color: #9e9e9e;
}

#appList {
    background: #121212;
}

#appList::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #e0e0e0;
}

#appList::item:selected {
    background: #d0bcff;
    color: #000000;
}

#appList QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
}

#appList QScrollBar::handle:vertical {
    background-color: #2c2c2c;
    min-height: 30px;
    border-radius: 3px;
}

#appList QScrollBar::handle:vertical:hover {
    background-color: #d0bcff;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#appList QScrollBar::add-page:vertical,
#appList QScrollBar::sub-page:vertical {
    background: none;
}

#bottomBar {
    background: #121212;
    border-top: 1px solid #2c2c2c;
}

#bottomBar QToolButton {
    padding: 4px 6px;
    border-radius: 4px;
    color: #e0e0e0;
}

#bottomBar QToolButton:hover {
    background-color: #1e1e1e;
    border: 1px solid #03dac6;
}

#bottomBar QLabel {
    color: #9e9e9e;
}

#actionItem {
    margin: 4px 6px;
}

#actionButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #e0e0e0;
    border-radius: 4px;
}

#actionButton:hover {
    background: #1e1e1e;
    border: 1px solid #d0bcff;
}

#actionShortcut {
    color: #9e9e9e;
    background: transparent;
}

#actionName {
    color: #e0e0e0;
    background: transparent;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 transparent,
                                 stop: 1 #121212);
}
