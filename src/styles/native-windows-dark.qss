QWidget {
    background-color: transparent;
    color: #f5f5f5;
}

#mainWindow {
    background-color: #202020;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 8px;
}

#searchbarInput {
    background-color: #2b2b2b;
    color: #f5f5f5;
    border: 1px solid #5b5b5b;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

#searchbarInput:focus { border: 2px solid @ACCENT@; }
#searchbarInput::placeholder { color: #a0a0a0; }
#appList { background-color: #202020; border: none; }
#appList::item { padding: 7px 10px; border-radius: 4px; }
#appList::item:selected { background-color: @ACCENT@; color: #ffffff; }
#appList QScrollBar:vertical { background: transparent; width: 8px; }
#appList QScrollBar::handle:vertical { background: #5b5b5b; border-radius: 4px; min-height: 24px; }
#appList QScrollBar::add-line:vertical, #appList QScrollBar::sub-line:vertical { height: 0; }
#listFade { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #202020, stop: 1 #202020); }
#bottomBar { background-color: #202020; border-top: 1px solid #505050; }
#bottomBar QLabel { color: #a0a0a0; }
#bottomBar QToolButton { color: #f5f5f5; background: transparent; border: none; padding: 4px 6px; }
#bottomBar QToolButton:hover { background-color: #2b2b2b; }
#actionButton { color: #f5f5f5; background: transparent; border: none; padding: 4px 6px; }
#actionShortcut { color: #a0a0a0; background: transparent; }
#actionName { color: #f5f5f5; background: transparent; }
