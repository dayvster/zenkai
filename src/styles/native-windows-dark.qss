QWidget {
    background-color: transparent;
    color: #f3f3f3;
    font-family: "Segoe UI Variable", "Segoe UI";
    font-size: 14px;
}

#mainWindow {
    background-color: #202020;
    border: 1px solid rgba(255, 255, 255, 28);
    border-radius: 8px;
}

#searchbarInput {
    background-color: #202020;
    color: #f3f3f3;
    border: none;
    border-bottom: 1px solid #383838;
    border-radius: 0;
    padding: 18px 20px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}

#searchbarInput:focus {
    border-bottom: 1px solid #383838;
}

#searchbarInput::placeholder {
    color: #a0a0a0;
}

#appList {
    background-color: #202020;
    border: none;
}

#appList::item {
    padding: 8px 12px;
    margin: 2px 8px;
    border-radius: 6px;
}

#appList::item:hover {
    background-color: #2b2b2b;
}

#appList::item:selected {
    background-color: #383838;
    color: #f3f3f3;
}

#appList QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 3px 2px;
}

#appList QScrollBar::handle:vertical {
    background: #5f5f5f;
    border-radius: 4px;
    min-height: 24px;
}

#appList QScrollBar::handle:vertical:hover {
    background: #858585;
}

#appList QScrollBar::add-line:vertical,
#appList QScrollBar::sub-line:vertical {
    height: 0;
}

#listFade {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #202020, stop: 1 #202020);
}

#bottomBar {
    background-color: #202020;
    border-top: 1px solid rgba(255, 255, 255, 24);
}

#bottomBar QLabel,
#actionShortcut {
    color: #a0a0a0;
    background: transparent;
}

#bottomBar QToolButton,
#actionButton {
    color: #f3f3f3;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 5px 8px;
}

#bottomBar QToolButton:hover,
#actionButton:hover {
    background-color: #333333;
}

#actionName {
    color: #f3f3f3;
    background: transparent;
}

#actionShortcut {
    border-color: #383838;
}

#actionMenu {
    background-color: #202020;
    color: #f3f3f3;
    border-color: #383838;
}

#actionMenuSearch {
    background: #292929;
    color: #f3f3f3;
    border-color: #454545;
}
#actionMenuSearch:focus { border-color: @ACCENT@; }
#actionMenuContext, #actionMenuHint, #actionMenuEmpty { color: #a0a0a0; }
#actionMenu::separator { background: #383838; }
#actionMenu::item:selected { background: #383838; color: #ffffff; }
